# `l[$j]` expands to one operand per element of $j: set -e erases them one after
# another, set -q counts each, and set takes the first as its target
set l a b c d; set j 1 3; set -e l[$j]; echo "1: $l $status"
set l a b c d; set j 1 2; set -e l[$j]; echo "2: $l $status"
set l a b c d; set j "1 3"; set -e l[$j]; echo "3: $l $status"
set l a b c d; set j 1 x; set -e l[$j] 2>/dev/null; echo "4: $l $status"
set l a b c d; set j 2 9; set -e l[$j]; echo "5: $l $status"
set l a b c d; set j 1..2 4; set -e l[$j]; echo "6: $l $status"
set -e nope; set j 1 2; set -e nope[$j]; echo "7: $status"
set l a b c d; set j; set -e l[$j] 2>/dev/null; echo "8: $l $status"
set l a b c d; set j 1 2; set l[$j] X Y 2>/dev/null; echo "9: $l $status"
set l a b c d; set j 1 2; set l[$j] X 2>/dev/null; echo "10: $l $status"
set l a b c d; set j 2; set l[$j] X; echo "11: $l $status"
set l a b c; set j 1 2; set -q l[$j]; echo "12: $status"
set l a b c; set j 2 5 7; set -q l[$j]; echo "13: $status"
set l a b c; set -q l[1 4 -9]; echo "14: $status"
set l a b c; set -q l[1..5]; echo "15: $status"
set -e nope; set -q nope[1 2] x; echo "16: $status"
set l a b c d; set -e nope l[1]; echo "17: $l $status"
set l a b c d; set -e l[1] l[1]; echo "18: $l $status"
