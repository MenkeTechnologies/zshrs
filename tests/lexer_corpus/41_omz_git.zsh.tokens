STRING	"$ZSH_THEME_GIT_PROMPT_REMOTE_EXISTS"
SEPER	
ELSE	else
SEPER	
STRING	echo
STRING	"$ZSH_THEME_GIT_PROMPT_REMOTE_MISSING"
SEPER	
FI	fi
SEPER	
OUTBRACE	}
SEPER	
SEPER	
