FUNC	function
STRING	takeurl
INOUTPAR	
INBRACE	{
SEPER	
TYPESET	local
STRING	data
STRING	thedir
SEPER	
ENVSTRING	data="$(mktemp)"
SEPER	
STRING	curl
STRING	-L
STRING	"$1"
OUTANG	
STRING	"$data"
SEPER	
STRING	tar
STRING	xf
STRING	"$data"
SEPER	
ENVSTRING	thedir="$(tar tf "$data" | head -n 1)"
SEPER	
STRING	rm
STRING	"$data"
SEPER	
STRING	cd
STRING	"$thedir"
SEPER	
OUTBRACE	}
SEPER	
