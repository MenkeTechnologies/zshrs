FUNC	function
STRING	takezip
INOUTPAR	
INBRACE	{
SEPER	
TYPESET	local
STRING	data
STRING	thedir
SEPER	
ENVSTRING	data="$(mktemp)"
SEPER	
STRING	curl
STRING	-L
STRING	"$1"
OUTANG	
STRING	"$data"
SEPER	
STRING	unzip
STRING	"$data"
STRING	-d
STRING	"./"
SEPER	
ENVSTRING	thedir="$(unzip -l "$data" | awk 'NR==4 {print $4}' | sed 's/\/.*//')"
SEPER	
STRING	rm
STRING	"$data"
SEPER	
STRING	cd
STRING	"$thedir"
SEPER	
OUTBRACE	}
SEPER	
SEPER	
