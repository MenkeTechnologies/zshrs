FUNC	function
STRING	omz_urlencode
INOUTPAR	
INBRACE	{
SEPER	
STRING	emulate
STRING	-L
STRING	zsh
SEPER	
STRING	setopt
STRING	norematchpcre
SEPER	
SEPER	
TYPESET	local
STRING	-a
STRING	opts
SEPER	
STRING	zparseopts
STRING	-D
STRING	-E
STRING	-a
STRING	opts
STRING	r
STRING	m
STRING	P
SEPER	
SEPER	
TYPESET	local
STRING	in_str="$@"
SEPER	
TYPESET	local
STRING	url_str=""
SEPER	
TYPESET	local
STRING	spaces_as_plus
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	$opts[(r)-P]
DOUTBRACK	]]
SEPER	
THEN	then
ENVSTRING	spaces_as_plus=1
SEPER	
FI	fi
SEPER	
TYPESET	local
STRING	str="$in_str"
SEPER	
SEPER	
SEPER	
TYPESET	local
STRING	encoding=$langinfo[CODESET]
SEPER	
TYPESET	local
STRING	safe_encodings
SEPER	
ENVARRAY	safe_encodings
STRING	UTF-8
STRING	utf8
STRING	US-ASCII
OUTPAR	
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	${safe_encodings[(r)$encoding]}
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	str=$(echo -E "$str" | iconv -f $encoding -t UTF-8)
SEPER	
IF	if
DINBRACK	[[
STRING	$?
STRING	!=
STRING	0
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	echo
STRING	"Error converting string from $encoding to UTF-8"
OUTANGAMP	
STRING	2
SEPER	
STRING	return
STRING	1
SEPER	
FI	fi
SEPER	
FI	fi
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
TYPESET	local
STRING	i
STRING	byte
STRING	ord
STRING	LC_ALL=C
SEPER	
TYPESET	export
STRING	LC_ALL
SEPER	
TYPESET	local
STRING	reserved=';/?:@&=+$,'
SEPER	
TYPESET	local
STRING	mark='_.!~*''()-'
SEPER	
TYPESET	local
STRING	dont_escape="[A-Za-z0-9"
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	$opts[(r)-r]
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	dont_escape+=$reserved
SEPER	
FI	fi
SEPER	
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	$opts[(r)-m]
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	dont_escape+=$mark
SEPER	
FI	fi
SEPER	
ENVSTRING	dont_escape+="]"
SEPER	
SEPER	
SEPER	
SEPER	
TYPESET	local
STRING	url_str=""
SEPER	
FOR	for
DINPAR	
DINPAR	i = 1
DINPAR	i <= ${#str}
DOUTPAR	++i 
SEPER	
DOLOOP	do
SEPER	
ENVSTRING	byte="$str[i]"
SEPER	
IF	if
DINBRACK	[[
STRING	"$byte"
STRING	=~
STRING	"$dont_escape"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	url_str+="$byte"
SEPER	
ELSE	else
SEPER	
IF	if
DINBRACK	[[
STRING	"$byte"
STRING	==
STRING	" "
DAMPER	
STRING	-n
STRING	$spaces_as_plus
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	url_str+="+"
SEPER	
ELIF	elif
DINBRACK	[[
STRING	"$PREFIX"
STRING	=
STRING	*com.termux*
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
SEPER	
ENVSTRING	url_str+="$byte"
SEPER	
ELSE	else
SEPER	
ENVSTRING	ord=$(( [##16] #byte ))
SEPER	
ENVSTRING	url_str+="%$ord"
SEPER	
FI	fi
SEPER	
FI	fi
SEPER	
DONE	done
SEPER	
STRING	echo
STRING	-E
STRING	"$url_str"
SEPER	
OUTBRACE	}
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
FUNC	function
STRING	omz_urldecode
STRING	{
SEPER	
STRING	emulate
STRING	-L
STRING	zsh
SEPER	
TYPESET	local
STRING	encoded_url=$1
SEPER	
SEPER	
SEPER	
TYPESET	local
STRING	caller_encoding=$langinfo[CODESET]
SEPER	
TYPESET	local
STRING	LC_ALL=C
SEPER	
TYPESET	export
STRING	LC_ALL
SEPER	
SEPER	
SEPER	
TYPESET	local
STRING	tmp=${encoded_url:gs/+/ /}
SEPER	
SEPER	
ENVSTRING	tmp=${tmp:gs/\\/\\\\/}
SEPER	
SEPER	
ENVSTRING	tmp=${tmp:gs/%/\\x/}
SEPER	
TYPESET	local
STRING	decoded="$(printf -- "$tmp")"
SEPER	
SEPER	
SEPER	
SEPER	
TYPESET	local
STRING	-a
STRING	safe_encodings
SEPER	
ENVARRAY	safe_encodings
STRING	UTF-8
STRING	utf8
STRING	US-ASCII
OUTPAR	
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	${safe_encodings[(r)$caller_encoding]}
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	decoded=$(echo -E "$decoded" | iconv -f UTF-8 -t $caller_encoding)
SEPER	
IF	if
DINBRACK	[[
STRING	$?
STRING	!=
STRING	0
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	echo
STRING	"Error converting string from UTF-8 to $caller_encoding"
OUTANGAMP	
STRING	2
SEPER	
STRING	return
STRING	1
SEPER	
FI	fi
SEPER	
FI	fi
SEPER	
SEPER	
STRING	echo
STRING	-E
STRING	"$decoded"
SEPER	
OUTBRACE	}
SEPER	
ENDINPUT
