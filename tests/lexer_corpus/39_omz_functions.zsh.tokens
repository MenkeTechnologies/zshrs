FUNC	function
STRING	take
INOUTPAR	
INBRACE	{
SEPER	
IF	if
DINBRACK	[[
STRING	$1
STRING	=~
STRING	^(https?|ftp).*\.(tar\.(gz|bz2|xz)|tgz)$
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	takeurl
STRING	"$1"
SEPER	
ELIF	elif
DINBRACK	[[
STRING	$1
STRING	=~
STRING	^(https?|ftp).*\.(zip)$
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	takezip
STRING	"$1"
SEPER	
ELIF	elif
DINBRACK	[[
STRING	$1
STRING	=~
STRING	^([A-Za-z0-9]\+@|https?|git|ssh|ftps?|rsync).*\.git/?$
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	takegit
STRING	"$1"
SEPER	
ELSE	else
SEPER	
STRING	takedir
STRING	"$@"
SEPER	
FI	fi
SEPER	
OUTBRACE	}
SEPER	
