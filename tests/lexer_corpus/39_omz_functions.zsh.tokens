FUNC	function
STRING	open_command
INOUTPAR	
INBRACE	{
SEPER	
TYPESET	local
STRING	open_cmd
SEPER	
SEPER	
SEPER	
CASE	case
STRING	"$OSTYPE"
STRING	in
SEPER	
STRING	darwin*
OUTPAR	
STRING	open_cmd='open'
DSEMI	
SEPER	
STRING	cygwin*
OUTPAR	
STRING	open_cmd='cygstart'
DSEMI	
SEPER	
STRING	linux*
OUTPAR	
STRING	[[
STRING	"$(uname -r)"
STRING	!=
STRING	*icrosoft*
STRING	]]
DAMPER	
ENVSTRING	open_cmd='nohup xdg-open'
DBAR	
INBRACE	{
SEPER	
ENVSTRING	open_cmd='cmd.exe /c start ""'
SEPER	
DINBRACK	[[
STRING	-e
STRING	"$1"
DOUTBRACK	]]
DAMPER	
INBRACE	{
ENVSTRING	1="$(wslpath -w "${1:a}")"
DBAR	
STRING	return
STRING	1
OUTBRACE	}
SEPER	
DINBRACK	[[
STRING	"$1"
STRING	=
INPAR	
STRING	http
BAR	
STRING	https
OUTPAR	
STRING	://*
DOUTBRACK	]]
DAMPER	
INBRACE	{
SEPER	
ENVSTRING	1="$(echo "$1" | sed -E 's/([&|()<>^])/^\1/g')"
DBAR	
STRING	return
STRING	1
SEPER	
OUTBRACE	}
SEPER	
OUTBRACE	}
DSEMI	
SEPER	
STRING	msys*
OUTPAR	
STRING	open_cmd='start ""'
DSEMI	
SEPER	
STRING	*
OUTPAR	
STRING	echo
STRING	"Platform $OSTYPE not supported"
SEPER	
STRING	return
STRING	1
SEPER	
DSEMI	
SEPER	
ESAC	esac
SEPER	
SEPER	
SEPER	
SEPER	
IF	if
DINBRACK	[[
STRING	-n
STRING	"$BROWSER"
DAMPER	
STRING	"$1"
STRING	=
INPAR	
STRING	http
BAR	
STRING	https
OUTPAR	
STRING	://*
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	"$BROWSER"
STRING	"$@"
SEPER	
STRING	return
SEPER	
FI	fi
SEPER	
SEPER	
STRING	${=open_cmd}
STRING	"$@"
AMPOUTANG	
STRING	/dev/null
SEPER	
OUTBRACE	}
SEPER	
SEPER	
SEPER	
SEPER	
SEPER	
