SEPER	
STRING	return
SEPER	
FI	fi
SEPER	
DONE	done
SEPER	
STRING	echo
STRING	main
SEPER	
OUTBRACE	}
SEPER	
SEPER	
ENVSTRING	branch='$(zsh-gacp-mainBranch)'
SEPER	
ENVSTRING	dir="$1"
SEPER	
SEPER	
IF	if
DINBRACK	[[
BANG	!
STRING	-d
STRING	"$dir"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	zpwrLogConsoleErr
STRING	"usage: forDirMain.sh DIR to run CMD in each dir/*"
SEPER	
STRING	exit
STRING	1
SEPER	
FI	fi
SEPER	
SEPER	
STRING	source
STRING	"$ZPWR_SCRIPTS/forDir.sh"
STRING	"zpwrIsGitDir && { _m=$branch; git checkout \$_m ; git fetch -f --all --prune --tags; git clean -dff && git reset --hard origin/\$_m && git clean -dff ; git pull --all; unset _m; }"
STRING	"$dir/"*
SEPER	
ENDINPUT
