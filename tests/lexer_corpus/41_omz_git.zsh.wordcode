STR[0]="autoload"
STR[1]="is\x9bat\x9bleast"
STR[2]="__git_prompt_git"
STR[3]="GIT_OPTIONAL_LOCKS"
STR[4]="command"
STR[5]="\x9e\x8c@\x9e"
STR[6]="_omz_git_prompt_info"
STR[7]="__git_prompt_git"
STR[8]="rev\x9bparse"
STR[9]="\x9b\x9bgit\x9bdir"
STR[10]="/dev/null"
STR[11]="\x9e\x8c\x88__git_prompt_git config --get oh-my-zsh.hide-info 2>/dev/null\x8a\x9e"
STR[12]="return"
STR[13]="local"
STR[14]="\x85\x88__git_prompt_git symbolic-ref --short HEAD 2> /dev/null\x8a"
STR[15]="\x85\x88__git_prompt_git describe --tags --exact-match HEAD 2> /dev/null\x8a"
STR[16]="\x85\x88__git_prompt_git rev-parse --short HEAD 2> /dev/null\x8a"
STR[17]="upstream"
STR[18]=" \x8c\x8f+ZSH_THEME_GIT_SHOW_UPSTREAM\x90 "
STR[19]="upstream"
STR[20]="\x85\x88__git_prompt_git rev-parse --abbrev-ref --symbolic-full-name \"@{upstream}\" 2>/dev/null\x8a"
STR[21]="upstream"
STR[22]="\x9e -> \x8c\x8fupstream\x90\x9e"
STR[23]="echo"
STR[24]="\x9e\x8c\x8fZSH_THEME_GIT_PROMPT_PREFIX\x90\x8c\x8fref:gs/%/%%\x90\x8c\x8fupstream:gs/%/%%\x90\x8c\x88parse_git_dirty\x8a\x8c\x8fZSH_THEME_GIT_PROMPT_SUFFIX\x90\x9e"
STR[25]="_omz_git_prompt_status"
STR[26]="\x9e\x8c\x88__git_prompt_git config --get oh-my-zsh.hide-status 2>/dev/null\x8a\x9e"
STR[27]="return"
STR[28]="local"
STR[29]="prefix_constant_map"
