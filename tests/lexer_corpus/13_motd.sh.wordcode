STR[64]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"         : .~.'~'.~. :     ___ ___ ___ ___| |_ ___ ___ ___ _ _    ___|_|      \"\x8a\x8cborderBar\\n\x9e"
STR[65]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"        ~ (   ) (   ) ~   |  _| .'|_ -| . | . | -_|  _|  _| | |  | . | |      \"\x8a\x8cborderBar\\n\x9e"
STR[66]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"       ( : '~'.~.'~' : )  |_| |__,|___|  _|___|___|_| |_| |_  |  |  _|_|      \"\x8a\x8cborderBar\\n\x9e"
STR[67]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"        ~ .~ (   ) ~. ~               |_|                 |___|  |_|          \"\x8a\x8cborderBar\\n\x9e"
STR[68]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"         (  : '~' :  )                                                        \"\x8a\x8cborderBar\\n\x9e"
STR[69]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"          '~ .~~~. ~'                                                         \"\x8a\x8cborderBar\\n\x9e"
STR[70]="\x9e\x8cheader\x8cborderBar\x8c\x88color $headerRaspberryColor \"              '~'                                                             \"\x8a\x8cborderBar\x9e"
STR[71]="\x85\x88whoami\x8a"
STR[72]="greetings"
STR[73]="\x9e\x8cborderBar\x8c\x88color $greetingsColor \"$(center \"Welcome back, $me!\")\"\x8a\x8cborderBar\\n\x9e"
STR[74]="\x9e\x8cgreetings\x8cborderBar\x8c\x88color $greetingsColor \"$(center \"$(date +\"%A, %d %B %Y, %T\")\")\"\x8a\x8cborderBar\x9e"
STR[75]="read"
STR[76]="loginFrom"
STR[77]="loginIP"
STR[78]="\x85\x88last $me -2 | awk 'NR==2 { print $2,$3 }'\x8a"
STR[79]="loginDate"
STR[80]="\x85\x88date -u -d \"$(last -2 | awk 'NR==2 {print $4,$5,$6,$7}')\" +\"%Y-%m-%dT%H:%M:%SZ\" \x8a"
STR[81]="\x85loginDate"
STR[82]="\x85loginIP"
STR[83]="\x85loginFrom"
STR[84]="login"
STR[85]="\x9e\x8c\x88date -d $loginDate +\"%A, %d %B %Y, %T\"\x8a (\x8cloginIP)\x9e"
STR[86]="\x9eNone\x9e"
STR[87]="label1"
STR[88]="\x9e\x8c\x88extend \"$login\"\x8a\x9e"
STR[89]="\x9e\x8cborderBar  \x8c\x88color $statsLabelColor \"Last Login....:\"\x8a \x8clabel1\x8cborderBar\x9e"
STR[90]="uptime"
STR[91]="\x9e\x8c\x88sec2time $(cut -d \".\" -f 1 /proc/uptime)\x8a\x9e"
STR[92]="\x9e\x8cuptime (\x8c\x88date -d \"@\"$(grep btime /proc/stat | cut -d \" \" -f 2) +\"%d-%m-%Y %H:%M:%S\"\x8a)\x9e"
STR[93]="label2"
STR[94]="\x9e\x8c\x88extend \"$uptime\"\x8a\x9e"
STR[95]="\x9e\x8cborderBar  \x8c\x88color $statsLabelColor \"Uptime........:\"\x8a \x8clabel2\x8cborderBar\x9e"
STR[96]="label3"
STR[97]="\x9e\x8c\x88extend \"$(free -m | awk 'NR==2 { printf \"Total: %sMB, Used: %sMB, Free: %sMB\",$2,$3,$4; }')\"\x8a\x9e"
STR[98]="\x9e\x8cborderBar  \x8c\x88color $statsLabelColor \"Memory........:\"\x8a \x8clabel3\x8cborderBar\x9e"
STR[99]="label4"
STR[100]="\x9e\x8c\x88extend \"$(df -h ~ | awk 'NR==2 { printf \"Total: %sB, Used: %sB, Free: %sB\",$2,$3,$4; }')\"\x8a\x9e"
STR[101]="\x9e\x8cborderBar  \x8c\x88color $statsLabelColor \"Home space....:\"\x8a \x8clabel4\x8cborderBar\x9e"
STR[102]="label5"
STR[103]="\x9e\x8c\x88extend \"$(/opt/vc/bin/vcgencmd measure_temp | cut -c \"6-9\")\xc2\xbaC\"\x8a\x9e"
