SEPER	
SEPER	
FOR	for
DINPAR	
DINPAR	
DINPAR	
DOUTPAR	
SEPER	
DOLOOP	do
SEPER	
STRING	break
SEPER	
DONE	done
SEPER	
SEPER	
FOR	for
DINPAR	
DINPAR	i = 1, j = 100
DINPAR	i <= 10
DOUTPAR	i++, j-- 
SEPER	
DOLOOP	do
SEPER	
STRING	echo
STRING	$i
STRING	$j
SEPER	
DONE	done
SEPER	
ENDINPUT
