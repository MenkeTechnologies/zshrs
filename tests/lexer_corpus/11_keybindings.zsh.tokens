SEPER	
IF	if
DINBRACK	[[
STRING	"$zpwrBaseDir"
STRING	==
STRING	/
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
STRING	echo
STRING	"Could not find .zpwr_root file up the directory tree."
OUTANGAMP	
STRING	2
SEPER	
STRING	exit
STRING	1
SEPER	
FI	fi
SEPER	
DONE	done
SEPER	
IF	if
BANG	!
STRING	source
STRING	"$zpwrBaseDir/scripts/init.sh"
STRING	"$zpwrBaseDir"
SEPER	
THEN	then
SEPER	
STRING	echo
STRING	"Could not source zpwrBaseDir '$zpwrBaseDir/scripts/init.sh'."
SEPER	
STRING	exit
STRING	1
SEPER	
FI	fi
SEPER	
STRING	unset
STRING	zpwrBaseDir
SEPER	
FI	fi
SEPER	
SEPER	
ENVSTRING	cmd=$ZPWR_VIM
SEPER	
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	"$ZPWR_TEMPFILE"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	ZPWR_TEMPFILE="/tmp/.temp$$"
SEPER	
FI	fi
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	"$ZPWR_TEMPFILE1"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	ZPWR_TEMPFILE1="/tmp/.temp$$-1"
SEPER	
FI	fi
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	"$ZPWR_TEMPFILE2"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	ZPWR_TEMPFILE2="/tmp/.temp$$-2"
SEPER	
FI	fi
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	"$ZPWR_TEMPFILE3"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	ZPWR_TEMPFILE3="/tmp/.temp$$-3"
SEPER	
FI	fi
SEPER	
IF	if
DINBRACK	[[
STRING	-z
STRING	"$ZPWR_TEMPFILE4"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
ENVSTRING	ZPWR_TEMPFILE4="/tmp/.temp$$-4"
SEPER	
FI	fi
SEPER	
INBRACE	{
SEPER	
STRING	$=cmd
STRING	-e
STRING	-c
STRING	'redir! > '$ZPWR_TEMPFILE1' | silent imap | redir END | quitall'
SEPER	
STRING	cat
STRING	$ZPWR_TEMPFILE1
SEPER	
STRING	$=cmd
STRING	-e
STRING	-c
STRING	'redir! > '$ZPWR_TEMPFILE2' | silent nmap | redir END | quitall'
SEPER	
STRING	cat
STRING	$ZPWR_TEMPFILE2
SEPER	
STRING	$=cmd
STRING	-e
STRING	-c
STRING	'redir! > '$ZPWR_TEMPFILE3' | silent vmap | redir END | quitall'
SEPER	
STRING	cat
STRING	$ZPWR_TEMPFILE3
SEPER	
STRING	$=cmd
STRING	-e
STRING	-c
STRING	'redir! > '$ZPWR_TEMPFILE4' | silent cmap | redir END | quitall'
SEPER	
STRING	cat
STRING	$ZPWR_TEMPFILE4
SEPER	
SEPER	
OUTBRACE	}
BAR	
STRING	stryke
STRING	-ne
STRING	'print if /\S+/'
OUTANG	
STRING	"$ZPWR_TEMPFILE"
SEPER	
SEPER	
STRING	command
STRING	rm
STRING	"$ZPWR_TEMPFILE1"
SEPER	
STRING	command
STRING	rm
STRING	"$ZPWR_TEMPFILE2"
SEPER	
STRING	command
STRING	rm
STRING	"$ZPWR_TEMPFILE3"
SEPER	
STRING	command
STRING	rm
