SEPER	
SEPER	
IF	if
DINBRACK	[[
STRING	-n
STRING	"$ZPWR"
DAMPER	
STRING	-n
STRING	"$ZPWR_LIB_INIT"
DOUTBRACK	]]
SEPER	
THEN	then
SEPER	
IF	if
BANG	!
STRING	source
STRING	"$ZPWR_LIB_INIT"
STRING	""
SEPER	
THEN	then
SEPER	
STRING	echo
STRING	"Could not source file ZPWR_LIB_INIT '$ZPWR_LIB_INIT'."
SEPER	
STRING	exit
STRING	1
SEPER	
FI	fi
SEPER	
ELSE	else
SEPER	
ENVSTRING	0="${${0:#$ZSH_ARGZERO}:-${(%):-%N}}"
SEPER	
ENVSTRING	0="${${(M)0:#/*}:-$PWD/$0}"
SEPER	
ENVSTRING	zpwrBaseDir="${0:A}"
SEPER	
SEPER	
WHILE	while
DINBRACK	[[
BANG	!
STRING	-f
STRING	"$zpwrBaseDir/.zpwr_root"
DOUTBRACK	]]
SEPER	
DOLOOP	do
SEPER	
