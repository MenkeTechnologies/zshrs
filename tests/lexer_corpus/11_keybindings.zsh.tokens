STRING	"$ZPWR_TEMPFILE"
BAR	
STRING	stryke
STRING	-pe
STRING	's@(.*) \(:.map\).*@$1@'
SEPER	
SEPER	
STRING	command
STRING	rm
STRING	"$ZPWR_TEMPFILE"
