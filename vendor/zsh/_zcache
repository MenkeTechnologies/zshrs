#compdef zcache

# Read / write / list the per-shell cache namespace. `zcache get K`
# / `zcache set K V [TTL]` / `zcache del K` / `zcache list
# [PREFIX]`. Backed by the daemon's in-memory KV with optional
# SQLite persistence.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs mirror the dispatch in daemon/builtins.rs.
# Bundled into ~/.zshrs/functions by build.rs.

local -a verbs
verbs=(
    info
    daemon
    clean
    verify
    compact
    list
    jobs
    view
    export
    import
    hydrate-view
    watch
    log
    config
    doctor
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest) _default && return 0 ;;
esac

return 1
