#compdef zsync

# Force a flush of the daemon's in-memory state to the SQLite
# catalog. Normally happens in the background; `zsync` makes it
# synchronous so a snapshot is consistent.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs mirror the dispatch in daemon/zsync_builtin.rs.
# Bundled into ~/.zshrs/functions by build.rs.

local -a verbs
verbs=(
    up
    push
    pull
    diff
    watch
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest) _default && return 0 ;;
esac

return 1
