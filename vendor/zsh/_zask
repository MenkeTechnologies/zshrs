#compdef zask

# Send an ask-style request to the daemon and print the JSON
# response. Used by tools/agents that want a single synchronous
# query against the shared catalog.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs mirror the dispatch in daemon/zask_builtin.rs.
# Bundled into ~/.zshrs/functions by build.rs.

local -a verbs
verbs=(
    ask
    progress
    pending
    take
    dismiss
    inbox-clear
    response
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest) _default && return 0 ;;
esac

return 1
