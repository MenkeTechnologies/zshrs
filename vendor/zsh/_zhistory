#compdef zhistory

# Query the daemon's federated command-history catalog. Spans every
# shell that pushed via `zcmd-result`. SQLite FTS5-backed; `zhistory
# search 'pattern'`.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs mirror the dispatch in daemon/zhistory_builtin.rs.
# Bundled into ~/.zshrs/functions by build.rs.

local -a verbs
verbs=(
    append
    add
    query
    search
    count
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest) _default && return 0 ;;
esac

return 1
