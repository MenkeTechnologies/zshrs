(elapsed; float if declared
.BR "typeset -F SECONDS" ),
.B $EPOCHSECONDS
.B $EPOCHREALTIME
(zsh/datetime),
.B $RANDOM
(0\(en32767 PRNG),
.B $SRANDOM
(32-bit unsigned).
.PP
.B Paths:
.B $PATH
