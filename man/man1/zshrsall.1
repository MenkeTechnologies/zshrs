.B $SUFFIX
.B $IPREFIX
.B $ISUFFIX
.B $compopaque .
.PP
.B Regex / match:
.B $MATCH
.B $match
.B $MBEGIN
.B $mbegin
.B $MEND
.B $mend
(populated after a successful
.B [[ str =~ regex ]]
or
.B (M)
parameter flag);
.B $BASH_REMATCH .
.PP
.B Editor:
.B $EDITOR
.B $VISUAL
