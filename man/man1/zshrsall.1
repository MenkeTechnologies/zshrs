.B $?
(last exit status),
.B $!
(last background PID),
.B $$
(shell PID),
.B $PPID
(parent PID),
.B $UID
.B $GID
.B $EUID
.B $EGID ,
.B $-
(current option letters),
.B $_
(last arg of previous command),
.B $pipestatus
(per-segment exit status of last pipeline).
.PP
