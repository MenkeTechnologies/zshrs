.B $RPS1
.B $RPROMPT
.B $SPROMPT
.B $PROMPT_EOL_MARK .
.PP
.B Locale:
.B $LANG
.B $LC_*
.B $LC_ALL .
.PP
.B Directory stack:
.B $PWD
.B $OLDPWD
.B $DIRSTACKSIZE
.B $dirstack .
.PP
.B History:
.B $HISTFILE
.B $HISTSIZE
