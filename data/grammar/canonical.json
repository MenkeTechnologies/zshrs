  "param_flags": [
    {
      "flag": "@",
      "doc": "array-context retain $@ semantics; quoting-preserving even in scalar context"
    },
    {
      "flag": "A",
      "doc": "create as an array"
    },
    {
      "flag": "a",
      "doc": "sort by array index"
    },
    {
      "flag": "c",
      "doc": "count words in a parameter (e.g., scalar split count)"
    },
    {
      "flag": "C",
      "doc": "capitalize words"
    },
    {
      "flag": "D",
      "doc": "treat as DIRECTORY name (apply directory substitution like ~/...)"
    },
    {
      "flag": "e",
      "doc": "perform parameter expansion / arithmetic / etc. on the result"
    },
    {
      "flag": "f",
      "doc": "split result at newlines"
    },
    {
      "flag": "F",
      "doc": "join array elements with newlines"
    },
    {
      "flag": "g",
      "doc": "process escape sequences like print does (g:o: process octals, g:c: process \\c)"
    },
    {
      "flag": "i",
      "doc": "case-insensitive sort"
    },
    {
      "flag": "j",
      "doc": "join array with separator: ${(j:sep:)arr}"
    },
    {
      "flag": "k",
      "doc": "for assoc arrays: keys ${(k)hash}"
    },
    {
      "flag": "K",
      "doc": "subscript flags: use keys"
    },
    {
      "flag": "L",
      "doc": "lowercase"
    },
    {
      "flag": "M",
      "doc": "match: use longest match (also for case-insensitivity in sort)"
    },
    {
      "flag": "n",
