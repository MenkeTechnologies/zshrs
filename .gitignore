# Runtime artifacts generated by `zshrs-recorder` / `zshrs` when the
# recorder corpus tests use a corpus-dir as $HOME — the daemon side
# writes its own toml + sqlite files into $HOME/.zshrs/.
tests/recorder_corpus/*/.zshrs/
