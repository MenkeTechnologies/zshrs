#!/usr/bin/env zshrs
# Integer arithmetic — operators, bit ops, base conversions.
echo "── arithmetic ──"
echo "2 + 3 = $((2 + 3))"
echo "10 - 4 = $((10 - 4))"
echo "6 * 7 = $((6 * 7))"
echo "100 / 7 = $((100 / 7))"
echo "100 % 7 = $((100 % 7))"
echo "2 ** 10 = $((2 ** 10))"
echo "-5 * 3 = $((-5 * 3))"
echo "precedence: 1 + 2 * 3 = $((1 + 2 * 3))"
echo "parens: (1 + 2) * 3 = $(( (1 + 2) * 3 ))"

echo "── bit ops ──"
echo "0xFF & 0x0F = $(( 0xFF & 0x0F ))"
echo "0xF0 | 0x0F = $(( 0xF0 | 0x0F ))"
echo "0xFF ^ 0xAA = $(( 0xFF ^ 0xAA ))"
echo "1 << 4 = $(( 1 << 4 ))"
echo "256 >> 2 = $(( 256 >> 2 ))"

echo "── base literals ──"
echo "hex 0xff = $(( 0xff ))"
echo "octal 0755 = $(( 0755 ))"
echo "binary 2#1010 = $(( 2#1010 ))"

# === ztest assertions ===
zassert_eq $((2 + 3))             5     "add"
zassert_eq $((10 - 4))            6     "sub"
zassert_eq $((6 * 7))             42    "mul"
zassert_eq $((100 / 7))           14    "div"
zassert_eq $((100 % 7))           2     "mod"
zassert_eq $((2 ** 10))           1024  "pow"
zassert_eq $((-5 * 3))            -15   "neg-mul"
zassert_eq $((1 + 2 * 3))         7     "precedence"
zassert_eq $(( (1 + 2) * 3 ))     9     "parens"
zassert_eq $(( 0xFF & 0x0F ))     15    "bit-and"
zassert_eq $(( 0xF0 | 0x0F ))     255   "bit-or"
zassert_eq $(( 0xFF ^ 0xAA ))     85    "bit-xor"
zassert_eq $(( 1 << 4 ))          16    "lshift"
zassert_eq $(( 256 >> 2 ))        64    "rshift"
zassert_eq $(( 0xff ))            255   "hex literal"
zassert_eq $(( 0755 ))            755   "octal literal (decimal by default; setopt OCTAL_ZEROES for 493)"
zassert_eq $(( 2#1010 ))          10    "binary literal"
ztest_run
