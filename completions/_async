#compdef async

# Run a command on the worker pool and print its job ID at once:
# `id=$(async 'cmd args')`, collected later with `await $id`.
#
# zshrs builtin. builtin_async (src/extensions/ext_builtins.rs) takes no
# options: it joins every argument with spaces and runs the result with
# `sh -c`, so the words complete as a command line.
# Bundled into ~/.zshrs/functions by build.rs.

_arguments '*:: :_normal'
