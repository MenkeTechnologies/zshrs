#compdef comparguments

# comparguments: argument parsing used by _arguments. The first argument
# selects the operation (the set accepted by bin_comparguments in
# Src/Zle/computil.c).

local -a ops
ops=(
    '-i:parse the command line against the specs (AUTODESC, then specs)'
    '-D:set the parameters for the descriptions, actions and sub-contexts for the current word'
    '-O:set the parameters for the next, direct, optional-direct and equal-sign option sets'
    '-L:set the description, action and sub-context parameters for the argument of a named option'
    '-s:test whether single-letter options are being completed, setting a parameter to the last option argument form'
    '-M:set the parameter to the match specs for the spec set in use'
    '-a:status 0 if there are normal arguments to complete'
    '-W:set the line (current word without handled option prefixes) and option-argument parameters'
    '-n:set the parameter to the index of the word where normal arguments began'
)
if (( CURRENT == 2 )); then
    _describe -t options 'comparguments operation' ops
    return
fi
_default
