#compdef zjob

# Manage background jobs through the daemon: `zjob submit -- cmd …`
# queues, `zjob status ID`, `zjob output ID`, `zjob wait ID`, `zjob
# kill ID`. Jobs survive shell exit because the daemon owns them.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs mirror the dispatch in daemon/zjob_builtin.rs.
# Bundled into ~/.zshrs/functions by build.rs.

local -a verbs
verbs=(
    submit
    list
    ls
    status
    output
    out
    kill
    cancel
    attach
    wait
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest) _default && return 0 ;;
esac

return 1
