#compdef zping

# Round-trip probe against the zshrs daemon: prints the daemon uptime
# and the RTT; --all also lists every registered shell.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); flags mirror zping() in daemon/builtins.rs.
# Bundled into ~/.zshrs/functions by build.rs.

# A bare word is sent as the ping's echo payload (the last one wins).
_arguments \
    '--all[also list every shell registered with the daemon]' \
    '*:echo payload: '
