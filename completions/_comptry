#compdef comptry

# comptry [-m|-s] TAG ...: tag-set iteration for _tags; not meant to be
# typed interactively. -m treats the arguments as patterns matched against
# the registered tags; -s (plain mode) makes each tag its own set
# (computil.c:4095, 4114-4134).

_arguments -s \
    '(-s)-m[match the arguments as patterns against the registered tags]' \
    '(-m)-s[try each tag as a separate set]' \
    '*:tag: '
