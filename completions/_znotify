#compdef znotify

# Show a notification in other shells through the zshrs daemon: one
# shell by id, every shell (--all), the shells carrying a tag (--tag)
# or a user's shells (--user).
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); arguments mirror znotify() and parse_send_args()
# in daemon/builtins.rs: the target is the first word, the rest is the
# message.
# Bundled into ~/.zshrs/functions by build.rs.

_arguments -C \
    '(1 --tag --user)--all[notify every shell]' \
    '(1 --all --user)--tag[notify the shells carrying a tag]:tag:->tags' \
    '(1 --all --tag)--user[notify the shells of a user]:user:_users' \
    '(--all --tag --user)1:shell id:->shells' \
    '*::message: ' && return 0

case $state in
    shells|tags)
        # Live shells: parse the `zls` table (ID PID TTY UPTIME TAGS CWD,
        # print_shells_table in daemon/builtins.rs). Silent when the
        # daemon is down.
        local zhome=${ZSHRS_HOME:-$HOME/.zshrs} row expl
        local -a cols shells tags
        if [[ -S $zhome/daemon.sock ]]; then
            for row in ${${(f)"$(zls 2>/dev/null)"}[2,-1]}; do
                cols=( ${=row} )
                [[ $cols[1] == <-> ]] || continue
                shells+=( "$cols[1]:pid $cols[2], tty $cols[3], $cols[6,-1]" )
                [[ $cols[5] == - ]] || tags+=( ${(s:,:)cols[5]} )
            done
            tags=( ${(u)tags} )
        fi
        if [[ $state == shells ]]; then
            _describe -t shells 'shell id' shells && return 0
        else
            _wanted tags expl 'tag' compadd -a tags && return 0
        fi
        ;;
esac

return 1
