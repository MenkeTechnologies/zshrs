#compdef profile

# Profile a command, script string or function call through zprof:
# `profile CMD ...`, `profile -s SCRIPT`, `profile -f FUNC [ARGS]`,
# `profile --clear`, `profile --dump`.
#
# zshrs builtin. Modes mirror builtin_profile
# (src/extensions/ext_builtins.rs); keep in sync. Only args[0] is
# compared against a mode; every other spelling is code: the args are
# joined with spaces and run through execute_script, so the first word
# may be any command, function, alias or builtin. `-s` and `-f` run
# args[1..] joined the same way.
# Bundled into ~/.zshrs/functions by build.rs.

local -a modes
modes=(
  '--clear:clear accumulated profile data'
  '--dump:show accumulated profile data'
  '-s:profile a script string'
  '-f:profile a function call'
)

if (( CURRENT == 2 )) && [[ $PREFIX == -* ]]; then
  _describe -t modes 'mode' modes
  return
fi

case $words[2] in
  --clear|--dump)
    _message 'no arguments' ;;
  -s)
    if (( CURRENT == 3 )); then
      _cmdstring
    else
      _message 'more script words (joined with spaces)'
    fi
    ;;
  -f)
    # `-f FUNC ARGS...` runs "FUNC ARGS..." as code.
    if (( CURRENT == 3 )); then
      _functions
    else
      _default
    fi
    ;;
  *)
    # `profile CMD ARGS...`: complete as the command line it runs.
    shift words
    (( CURRENT-- ))
    _normal
    ;;
esac
