#autoload

# zshrs --fish: completion the way fish does it. Runs ahead of `_complete` in
# the `completer` style:
#   - an argument is completed from fish's own definitions (`complete` in
#     config.fish / conf.d, `<cmd>.fish` on $fish_complete_path, the installed
#     fish's built-in scripts); with none for the command this returns 1 and
#     zsh's completer for it runs instead;
#   - the command word, a `$variable` and `~user` get fish's candidates and
#     descriptions (commands, functions, builtins, abbreviations; `Variable:
#     value`; `Home for user`).

# where the cursor is (command word, argument, variable, user) is decided from
# the fish text itself: zsh strips precommands (`command`, `builtin`, `exec`)
# from $words, fish does not
[[ $compstate[context] == (command|parameter|tilde) ]] || return 1

local -a __fish_cw __fish_cd __fish_cs spaced bare group replace
local __fish_cf __fish_ck __fish_cu __fish_cq i w

__fish_complete_query -- "$LBUFFER" || return 1

for (( i = 1; i <= $#__fish_cw; i++ )); do
  # the query answers whole words; compsys has already taken `$` / `foo$` /
  # `~` off into $IPREFIX for a variable or a user name
  w=${__fish_cw[i]#"$IPREFIX"}
  w=${w//:/\\:}
  [[ -n $__fish_cd[i] ]] && w+=":${__fish_cd[i]}"
  if [[ $__fish_cs[i] == 1 ]]; then
    bare+=("$w")
  else
    spaced+=("$w")
  fi
done

[[ $__fish_ck == 1 ]] && group=(-V) || group=(-J)
# fish replaces the word when the best match is not a prefix of it
[[ $__fish_cu == 1 ]] && replace=(-U)
# a path through a variable (`$HOME/Doc`) keeps the variable unexpanded and
# unquoted, as fish does
[[ $__fish_cq == 1 ]] && replace=(-Q -U)
(( $#spaced )) && _describe $group -t fish-completions completion spaced $replace
(( $#bare )) && _describe $group -t fish-completions completion bare -S '' $replace
[[ $__fish_cf == 1 ]] && _files
return 0
