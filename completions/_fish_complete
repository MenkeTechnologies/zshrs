#autoload

# zshrs --fish: completion the way fish does it. Runs ahead of `_complete` in
# the `completer` style:
#   - an argument is completed from fish's own definitions (`complete` in
#     config.fish / conf.d, `<cmd>.fish` on $fish_complete_path, the installed
#     fish's built-in scripts); with none for the command this returns 1 and
#     zsh's completer for it runs instead;
#   - the command word, a `$variable` and `~user` get fish's candidates and
#     descriptions (commands, functions, builtins, abbreviations; `Variable:
#     value`; `Home for user`).

# where the cursor is (command word, argument, variable, user) is decided from
# the fish text itself: zsh strips precommands (`command`, `builtin`, `exec`)
# from $words, fish does not
[[ $compstate[context] == (command|parameter|tilde) ]] || return 1

local -a __fish_cw __fish_cd __fish_cs __fish_ce spaced bare escaped escaped_bare group replace close
local __fish_cf __fish_ck __fish_cu __fish_cq __fish_clist __fish_ct __fish_cqt lead i w
local line=$LBUFFER raw=$words[CURRENT] bare_word

# while completing, zsh takes a word's unclosed quote out of $LBUFFER
# (`echo "sp a` reads `echo sp a`); $words keeps the word as typed, and fish
# must see the quote to read `sp a` as one word (in a `$variable` zsh leaves
# the quote where it is)
bare_word=${raw/[\"\']/}
[[ $raw != $bare_word && $line != *$raw && $line == *$bare_word ]] && line=${line%$bare_word}$raw

__fish_complete_query -- "$line" || return 1

# compsys has moved `$`, `foo$` or `~` into $IPREFIX for a variable or a user
# name; the query answers whole words, so the whole word is matched and, when
# fish replaces it, replaced
PREFIX=$IPREFIX$PREFIX
IPREFIX=
# zsh keeps an unclosed `{` (and what precedes it) out of the word it
# completes; that part stays in the line, so it comes off the matches
[[ $PREFIX != $__fish_ct && $__fish_ct == *$PREFIX ]] && lead=${__fish_ct%$PREFIX}

for (( i = 1; i <= $#__fish_cw; i++ )); do
  w=$__fish_cw[i]
  [[ -n $lead ]] && w=${w#$lead}
  # inside quotes compsys has taken the opening quote off the word already
  [[ -n $compstate[quote] ]] && w=${w#$compstate[quote]}
  # _describe (compdescribe's rembslash) drops every backslash and splits
  # at the first bare `:`, in the match and in its description alike
  w=${${w//\\/\\\\}//:/\\:}
  [[ -n $__fish_cd[i] ]] && w+=":${__fish_cd[i]//\\/\\\\}"
  # a control character goes in as fish writes it (`\n`), not as zsh quotes it
  if [[ -n $__fish_ce[i] && -z $compstate[quote] ]]; then
    w=$__fish_ce[i]
    [[ -n $lead ]] && w=${w#$lead}
    w=${${w//\\/\\\\}//:/\\:}
    [[ -n $__fish_cd[i] ]] && w+=":${__fish_cd[i]//\\/\\\\}"
    [[ $__fish_cs[i] == 1 ]] && escaped_bare+=("$w") || escaped+=("$w")
  elif [[ $__fish_cs[i] == 1 ]]; then
    bare+=("$w")
  else
    spaced+=("$w")
  fi
done

[[ $__fish_ck == 1 ]] && group=(-V) || group=(-J)
# fish replaces the word when the best match is not a prefix of it
[[ $__fish_cu == 1 ]] && replace=(-U)
# a word through a variable (`$HOME/Doc`, `$HOM`) or a `~user` goes in as
# written, unquoted, as fish does
[[ $__fish_cq == 1 ]] && replace=(-Q -U)
# fish closes a quote the word left open before the space after a match;
# zsh does that itself only for a quote it knows of ($compstate[quote]), not
# one it put in $IPREFIX (`"$US`)
[[ -n $__fish_cqt && -z $compstate[quote] && $__fish_cu != 1 ]] && close=(-S "$__fish_cqt ")
(( $#spaced )) && _describe $group -t fish-completions completion spaced $replace $close
(( $#bare )) && _describe $group -t fish-completions completion bare -S '' $replace
(( $#escaped )) && _describe $group -t fish-completions completion escaped -Q ${replace:#-Q} $close
(( $#escaped_bare )) && _describe $group -t fish-completions completion escaped_bare -S '' -Q ${replace:#-Q}
# fish only lists several matches that replace the word unless their common
# prefix is longer than it
[[ $__fish_clist == 1 ]] && compstate[insert]=''
[[ $__fish_cf == 1 ]] && _files
return 0
