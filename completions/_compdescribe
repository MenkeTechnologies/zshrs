#compdef compdescribe

# compdescribe: builds the match displays for _describe (Src/Zle/computil.c
# bin_compdescribe). Initialise with
#   -i HIDE MLEN SPEC ...
#   -I HIDE MLEN SEPARATOR OPTARRAY SPEC ...
# (-I shows descriptions), then call repeatedly with
#   -g LIST OPTS MATCHES DISPLAYS
# naming four parameters to set.

local -a ops
ops=(
    '-i:initialize, displaying matches without descriptions'
    '-I:initialize, displaying descriptions (separator and options array follow)'
    '-g:step to the next set of matches and store its parts in four parameters'
)
if (( CURRENT == 2 )); then
    _describe -t options 'compdescribe operation' ops
    return
fi
if [[ $words[2] == -g ]]; then
    _parameters
    return
fi
_default
