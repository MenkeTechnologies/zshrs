#compdef zcomplete

# Ask the daemon's `complete` op for candidates (commands, handlers,
# history) matching a command-line prefix, and print the JSON reply.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); arguments mirror zcomplete in
# daemon/zcomplete_builtin.rs: one PREFIX and --limit N.
# Bundled into ~/.zshrs/functions by build.rs.

_arguments \
    '--limit[maximum candidates]:limit:' \
    '(- *)'{-h,--help}'[print usage]' \
    '1:command-line prefix:_command_names -e'
