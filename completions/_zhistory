#compdef zhistory

# Append to and query the daemon's history catalog (history.db).
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs and flags mirror the dispatch in
# daemon/zhistory_builtin.rs; --mode values mirror the filter match in
# daemon/history.rs (query).
# Bundled into ~/.zshrs/functions by build.rs.

local curcontext=$curcontext state line
typeset -A opt_args

local -a verbs
verbs=(
    'append:add one history row'
    'add:same as append'
    'query:search history rows'
    'search:same as query'
    'count:print the number of history rows'
    '--help:print usage'
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest)
        local prev=$words[CURRENT-1]
        local -a flags modes
        case $words[1] in
            append|add)
                # append LINE, then flags.
                flags=(
                    '--exit-code:exit status of the command'
                    '--cwd:directory the command ran in'
                    '--duration-ns:run time in nanoseconds'
                    '--ts-ns:start time in nanoseconds since the epoch'
                    '--shell-id:id of the recording shell'
                )
                if (( CURRENT == 2 )); then
                    _message 'command line' && return 0
                fi
                case $prev in
                    --cwd) _directories && return 0 ;;
                    --exit-code|--duration-ns|--ts-ns|--shell-id)
                        _message "${prev#--} (integer)" && return 0
                        ;;
                    *) _describe -t options 'option' flags && return 0 ;;
                esac
                ;;
            query|search)
                flags=(
                    '--filter:text to match'
                    '--mode:how --filter matches'
                    '--cwd:only rows run in this directory'
                    '--limit:maximum rows'
                    '--asc:oldest first'
                    '--after-ns:only rows at or after this time (ns)'
                    '--before-ns:only rows at or before this time (ns)'
                )
                modes=(
                    'match:FTS5 MATCH (default)'
                    'fts:same as match'
                    'like:substring'
                    'prefix:line starts with the filter'
                    'exact:whole line equals the filter'
                )
                case $prev in
                    --mode) _describe -t modes 'mode' modes && return 0 ;;
                    --cwd) _directories && return 0 ;;
                    --filter) _message 'filter text' && return 0 ;;
                    --limit|--after-ns|--before-ns)
                        _message "${prev#--} (integer)" && return 0
                        ;;
                    *) _describe -t options 'option' flags && return 0 ;;
                esac
                ;;
        esac
        ;;
esac

return 1
