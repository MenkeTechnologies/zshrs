#compdef zlog

# Append a structured log entry to the daemon's log catalog. `zlog
# 'message' [key=val …]`. Queryable later via `zhistory` / `dbview`.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); verbs mirror the dispatch in daemon/builtins.rs.
# Bundled into ~/.zshrs/functions by build.rs.

local -a verbs
verbs=(
    path
    tail
    grep
    clear
    stats
    level
    rotate
)

_arguments -C \
    '1:sub-command:->verb' \
    '*::arg:->rest' && return 0

case $state in
    verb) _describe -t commands 'sub-command' verbs && return 0 ;;
    rest) _default && return 0 ;;
esac

return 1
