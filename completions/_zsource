#compdef zsource

# Ask the zshrs daemon's compiled-file registry about a sourced file:
# hit, stale or miss for its cached body.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); flags mirror zsource() in
# daemon/zsource_builtin.rs: one path, optional --stat.
# Bundled into ~/.zshrs/functions by build.rs.

_arguments \
    '(- *)'{-h,--help}'[print usage]' \
    '--stat[also send the file'"'"'s mtime and inode for a staleness check]' \
    '1:file to resolve:_files'
