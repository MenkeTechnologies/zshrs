#compdef nameref

# ksh93 named reference: `nameref NAME=REFERENT` is `typeset -n NAME=REFERENT`.
#
# zshrs builtin. Options mirror the `nameref` BUILTIN entry in
# src/ported/builtin.rs (bin_typeset, optstr "gpru", default flag "n"),
# itself a port of Src/Modules/ksh93.c bintab; keep in sync.
# Bundled into ~/.zshrs/functions by build.rs.

local curcontext=$curcontext state line
typeset -A opt_args

_arguments -s -S -C \
    '-g[do not restrict the reference to local scope]' \
    '-p[print the named references as typeset commands]' \
    '-r[mark the references readonly]' \
    '-u[resolve the referent in the calling function scope]' \
    '*: :->ref' && return 0

case $state in
    ref)
        if compset -P '*='; then
            _parameters && return 0
        else
            _parameters -q -S = && return 0
        fi
        ;;
esac

return 1
