#compdef zsuggest

# Ask the zshrs daemon's suggestion engine for a completion of a
# command-line prefix, optionally scored for a directory.
#
# zshrs builtin. Registered in ZSHRS_BUILTIN_NAMES
# (daemon/builtins.rs); flags mirror zsuggest() in
# daemon/zcomplete_builtin.rs: one prefix, optional --cwd DIR.
# Bundled into ~/.zshrs/functions by build.rs.

_arguments \
    '(- *)'{-h,--help}'[print usage]' \
    '--cwd[directory to suggest for (default: the current one)]:directory:_directories' \
    '1:command-line prefix: '
