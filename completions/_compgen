#compdef compgen complete

# bash-compatibility builtins: `compgen` prints candidate words, `complete`
# records (or lists, or removes) a bash completion spec for commands.
#
# zshrs builtins (native mode only; --zsh reports them as not found).
# Parsers: builtin_compgen and builtin_complete in
# src/extensions/ext_builtins.rs; keep in sync.
#
# compgen parses like bash getopt: letters cluster (`-fd`), a value is
# glued or the next word, `--` ends options. complete matches whole words
# only: every flag is its own word and a value is the NEXT word.
#
# `complete` shares this file because a `_complete` file would shadow
# compsys's own `_complete` completer.
# Bundled into ~/.zshrs/functions by build.rs.

local curcontext=$curcontext state line ret=1
typeset -A opt_args

case $service in
  compgen)
    # Letter flags and -A NAME select the generated actions; -D -E -I -r
    # are no-ops that take no value. -F runs a function and collects
    # COMPREPLY, -C runs a command, -X filters, -P/-S wrap each result.
    # The last non-option word is the prefix filter.
    _arguments -C -s \
      '-W[split a word list on whitespace and add the words]:word list: ' \
      '-G[add files matching this glob pattern]:glob pattern: ' \
      '-a[alias names]' \
      '-b[builtin names, including zshrs extension builtins]' \
      '-c[command names]' \
      '-d[directories in the current directory]' \
      '-e[exported variables]' \
      '-f[files in the current directory]' \
      '-j[job names (generates nothing)]' \
      '-k[reserved words]' \
      '-g[group names]' \
      '-s[service names]' \
      '-u[user names]' \
      '-v[scalar parameters and environment variables]' \
      '-F[completion function whose COMPREPLY supplies words]:function:->function' \
      '-C[command whose output lines supply words]:command:_command_names' \
      '-S[suffix added to each word]:suffix: ' \
      '-P[prefix added to each word]:prefix: ' \
      '-X[filter pattern]:filter pattern: ' \
      '-o[bash comp-option (plusdirs, dirnames, default, bashdefault act)]:comp-option:->compopt' \
      '-A[action by name]:action:->action' \
      '-D[no-op]' \
      '-E[no-op]' \
      '-I[no-op]' \
      '-r[no-op]' \
      ':prefix (keep candidates starting with it): ' && ret=0
    ;;
  complete)
    # -r removes the specs of every following word and stops. -A takes an
    # action by name; -o and -X take a value the spec does not store. Any
    # other dash word is skipped; every non-dash word is a command the
    # spec is stored for.
    _arguments -C \
      '-W[word list]:word list: ' \
      '-F[completion function]:function:->function' \
      '-C[command whose output supplies the words]:command:_command_names' \
      '-G[glob pattern]:glob pattern: ' \
      '-P[prefix added to each word]:prefix: ' \
      '-S[suffix added to each word]:suffix: ' \
      '-a[action: alias names]' \
      '-b[action: builtin names]' \
      '-c[action: command names]' \
      '-d[action: directory names]' \
      '-e[action: exported variables]' \
      '-f[action: file names]' \
      '-j[action: job names]' \
      '-A[action by name]:action:->action' \
      '-o[bash comp-option (accepted and ignored)]:comp-option:->compopt' \
      '-X[filter pattern (accepted and ignored)]:filter pattern: ' \
      '(- *)-p[print the specs of the named commands, or all]:*:registered command:->registered' \
      '(- *)-r[remove the specs of the named commands]:*:registered command:->registered' \
      '*:command:_command_names' && ret=0
    ;;
  *)
    return 1 ;;
esac

local -a expl
case $state in
  function)
    _wanted functions expl 'function' compadd -k functions && ret=0
    ;;
  action)
    # The long names each parser maps -A onto (COMPGEN_ACTIONS for compgen;
    # the a b c d e f j letters for complete).
    local -a actions
    actions=( alias builtin command directory export file job )
    [[ $service == compgen ]] && actions+=(
        arrayvar disabled enabled function group helptopic keyword
        service setopt shopt signal user variable
    )
    _wanted actions expl 'action' compadd -a actions && ret=0
    ;;
  compopt)
    # The option names bash's compgen/complete -o accept.
    local -a compopts
    compopts=(
      'bashdefault:fall back to the default bash completions'
      'default:fall back to readline default file completion'
      'dirnames:fall back to directory names'
      'filenames:treat the words as file names'
      'noquote:do not quote the words'
      'nosort:do not sort the words'
      'nospace:do not append a space'
      'plusdirs:add directory names to the words'
    )
    _describe -t comp-options 'comp-option' compopts && ret=0
    ;;
  registered)
    # Commands with a stored spec: the last word of each line `complete`
    # prints with no arguments.
    local -a cmds
    cmds=( ${${(f)"$(complete 2>/dev/null)"}##* } )
    _wanted commands expl 'command with a spec' compadd -a cmds && ret=0
    ;;
esac

return ret
