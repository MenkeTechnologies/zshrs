<idea-plugin>
    <id>com.menketechnologies.zshrs</id>
    <name>zshrs</name>
    <vendor email="linux.dev25@gmail.com" url="https://github.com/MenkeTechnologies/zshrs">MenkeTechnologies</vendor>

    <!-- BEGIN-CANONICAL: plugin-description -->
    <description><![CDATA[
        <p>JetBrains IDE support for <b>zshrs</b> — the first compiled Unix shell
        (Rust bytecode VM + fusevm JIT + persistent worker pool).</p>

        <ul>
            <li><b>.zsh / .zshrc / .zlogin / .zlogout / .zprofile / .zshenv</b> file association
                with syntax highlighting (keywords, builtins, sigils, parameters, options, redirections).</li>
            <li><b>LSP integration</b> via <code>zshrs --lsp</code>: completion (builtins, options,
                parameters, function names), hover docs, goto-definition, find-references, rename,
                document symbols, folding, formatting, diagnostics.</li>
            <li><b>Run configurations</b> for any zsh script with options for <code>--no-rcs</code>,
                <code>--xtrace</code>, <code>--verbose</code>, <code>--disasm</code> (fusevm bytecode dump),
                <code>--dump-ast</code>, working directory, script args.</li>
            <li><b>Debugger</b> wired to <code>zshrs --dap HOST:PORT</code> over TCP: line breakpoints,
                step over/into/out, frames, scopes, variables (scalars + arrays + hashes), evaluate.</li>
            <li><b>Color settings page</b> with 40+ slots for tweaking token colors.</li>
            <li><b>Settings → Tools → zshrs</b> to point at a non-PATH <code>zshrs</code> binary.</li>
            <li><b>Reflection tool window</b> showing builtins, options, keywords, parameter flags
                fetched live from <code>zshrs --dump-reflection</code>.</li>
        </ul>

        <p><b>Grammar coverage</b> (regenerated from canonical zsh sources, see
        <code>data/grammar/canonical.json</code>):</p>
        <ul>
            <li><!-- COUNT:keywords --><b>50</b> reserved keywords (control flow / declaration /
                modifier / I/O / loop control / grouping).</li>
            <li><!-- COUNT:builtins --><b>157</b> builtins (POSIX + zsh core +
                zsh modules + zshrs extensions).</li>
            <li><!-- COUNT:options --><b>196</b> <code>setopt</code> options (every name
                from upstream <code>options.c::optns[]</code>).</li>
            <li><!-- COUNT:special_vars --><b>88</b> special variables from
                <code>params.c::special_params[]</code>.</li>
            <li><!-- COUNT:param_flags --><b>38</b> parameter expansion flags
                (<code>${(L)var}</code>, <code>${(j:x:)arr}</code>, …).</li>
            <li><!-- COUNT:glob_qualifiers --><b>44</b> glob qualifiers
                (<code>*(.f-/)</code>, <code>**/*(N)</code>, …).</li>
            <li><!-- COUNT:operators --><b>55</b> operators / redirections
                / substitution forms.</li>
            <li><!-- COUNT:history_expansions --><b>10</b> history expansions and
                <!-- COUNT:modifiers --><b>16</b> word modifiers
                (<code>:h</code>, <code>:t</code>, <code>:s/old/new/</code>, …).</li>
        </ul>

        <p><b>Requirements:</b> a paid JetBrains IDE on 2024.2+ (RustRover, IDEA Ultimate, GoLand,
        PyCharm Pro, WebStorm, etc.) because zshrs uses the platform LSP API. Community editions
        are not supported.</p>
    ]]></description>
    <!-- END-CANONICAL: plugin-description -->

    <change-notes><![CDATA[
        <h3>0.11.4</h3>
        <ul>
            <li>Initial release. .zsh/.zshrc/etc file types, lexer-based highlighting,
                LSP client over <code>zshrs --lsp</code>, DAP debugger over <code>zshrs --dap</code>,
                run configurations, reflection tool window.</li>
        </ul>
    ]]></change-notes>

    <!-- Platform LSP API (paid IDEs) -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <!-- NOTE: do NOT declare `<depends>com.intellij.spellchecker</depends>`
         here. zshrs targets platformVersion 2024.2.4 where the
         spellchecker ships embedded in the platform JAR, NOT as a
         separately-installable plugin ID. Adding the depends tag fails
         plugin verification with "Plugin zshrs depends on unknown
         plugin com.intellij.spellchecker". The `spellchecker.support`
         EP below works without the depends declaration because the
         SpellcheckingStrategy class and EP are both available on the
         platform classpath. (strykelang on 2025.2 is the OPPOSITE
         case — there spellchecker is a module that NEEDS the depends
         tag + a bundledModule() build-script entry.) -->


    <extensions defaultExtensionNs="com.intellij">
        <!-- File types -->
        <fileType
            name="zsh"
            implementationClass="com.menketechnologies.zshrs.ZshrsFileType"
            fieldName="INSTANCE"
            language="zshrs"
            extensions="zsh"
            fileNames=".zshrc;.zshenv;.zlogin;.zlogout;.zprofile;.zpreztorc"/>
        <!-- `.sh` / `.bash` / `.ksh` / `.profile` etc. are NOT statically
             claimed here — they're added dynamically at startup based on
             Settings → zshrs → claimShFiles (and the comma-separated
             File extensions field for custom extensions). Avoids forcing
             zshrs colorization on users who write POSIX-only / bash-only
             scripts in `.sh` files. -->

        <!-- Startup activity that applies the dynamic extension list
             from ZshrsSettings. Runs once per IDE session; the settings
             dialog also re-applies on save. -->
        <postStartupActivity implementation="com.menketechnologies.zshrs.ZshrsExtensionAssociator"/>

        <!-- Parser definition (flat — token-stream PSI, no nested AST). Required
             for line-comment toggle, brace match, refactoring keymaps, and LSP
             code actions surfacing via Alt-Enter. -->
        <lang.parserDefinition
            language="zshrs"
            implementationClass="com.menketechnologies.zshrs.ZshrsParserDefinition"/>

        <!-- Highlighter -->
        <lang.syntaxHighlighterFactory
            language="zshrs"
            implementationClass="com.menketechnologies.zshrs.ZshrsSyntaxHighlighterFactory"/>

        <!-- Color settings page -->
        <colorSettingsPage implementation="com.menketechnologies.zshrs.ZshrsColorSettingsPage"/>

        <!-- Spell-check strategy: suppress TypoInspection on string /
             heredoc / comment / shebang tokens. Shell scripts are full
             of paths, C-function names (`Src/glob.c bracecomplete`,
             `paramsubst`), banner dividers, and one-letter identifiers
             that the platform dictionary flags as typos by default. -->
        <spellchecker.support
            language="zshrs"
            implementationClass="com.menketechnologies.zshrs.ZshrsSpellcheckingStrategy"/>

        <!-- Commenter (line comment with #) -->
        <lang.commenter language="zshrs" implementationClass="com.menketechnologies.zshrs.ZshrsCommenter"/>

        <!-- Complete Current Statement (Cmd-Shift-Enter):
             `if [[ $x ]]|` → `if [[ $x ]]; then\n    |\nfi`,
             `function foo|` → `function foo() {\n    |\n}`,
             `case $x|` → `case $x in\n    |\nesac`, plus bracket /
             quote balance and bare body openers (`then` / `do` / `in`). -->
        <lang.smartEnterProcessor language="zshrs"
            implementationClass="com.menketechnologies.zshrs.ZshrsSmartEnterProcessor"/>

        <!-- Brace / quote auto-pairing -->
        <lang.braceMatcher language="zshrs" implementationClass="com.menketechnologies.zshrs.ZshrsBraceMatcher"/>
        <lang.quoteHandler language="zshrs" implementationClass="com.menketechnologies.zshrs.ZshrsQuoteHandler"/>
        <!-- Skip-over `)` `]` `}` when the next char already matches —
             stops `tomm(){<ENTER>}` from doubling the close brace -->
        <typedHandler implementation="com.menketechnologies.zshrs.ZshrsTypedHandler"/>

        <!-- Refactoring bridge: hooks Cmd-Opt-M / Cmd-Opt-V / Cmd-Opt-C / Ctrl-T
             into LSP code actions; hooks Shift-F6 into LSP rename. -->
        <lang.refactoringSupport
            language="zshrs"
            implementationClass="com.menketechnologies.zshrs.refactor.ZshrsRefactoringSupportProvider"/>
        <renameHandler implementation="com.menketechnologies.zshrs.refactor.ZshrsRenameHandler"/>

        <!-- LSP server provider -->
        <platform.lsp.serverSupportProvider
            implementation="com.menketechnologies.zshrs.lsp.ZshrsLspServerSupportProvider"/>

        <!-- Cmd-B (Go To → Declaration or Usages):
             * on a usage, the platform's auto-wired LSP goto handles it;
             * on a decl, this bridge fires ShowUsages (popup), because
               the platform won't bridge to it for an LSP-backed language
               without PSI refs. -->
        <gotoDeclarationHandler implementation="com.menketechnologies.zshrs.navigate.ZshrsGotoDeclarationHandler"/>

        <!-- Settings -->
        <applicationService serviceImplementation="com.menketechnologies.zshrs.ZshrsSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.menketechnologies.zshrs.ZshrsSettingsConfigurable"
            id="com.menketechnologies.zshrs.settings"
            displayName="zshrs"/>

        <!-- Run configuration -->
        <configurationType implementation="com.menketechnologies.zshrs.run.ZshrsRunConfigurationType"/>
        <runConfigurationProducer
            implementation="com.menketechnologies.zshrs.run.ZshrsRunConfigurationProducer"/>
        <programRunner implementation="com.menketechnologies.zshrs.run.ZshrsProgramRunner"/>
        <programRunner implementation="com.menketechnologies.zshrs.run.ZshrsDebugRunner"/>

        <!-- Debugger: line-breakpoint type -->
        <xdebugger.breakpointType implementation="com.menketechnologies.zshrs.dap.ZshrsBreakpointType"/>

        <!-- Notifications for refactoring failure modes (no LSP, no
             matching code action, etc.). Without this registration
             `NotificationGroupManager.getNotificationGroup` returns
             null and balloons silently no-op. -->
        <notificationGroup id="zshrs Refactoring" displayType="BALLOON"/>

        <!-- Reflection tool window -->
        <toolWindow
            id="zshrs"
            anchor="right"
            secondary="false"
            icon="com.menketechnologies.zshrs.ZshrsIcons.FILE"
            factoryClass="com.menketechnologies.zshrs.toolwindow.ZshrsReflectionToolWindowFactory"/>
    </extensions>

    <actions>
        <action
            id="zshrs.RunFile"
            class="com.menketechnologies.zshrs.actions.RunZshrsFileAction"
            text="Run with zshrs"
            description="Run the selected zsh script with the zshrs interpreter"
            icon="com.menketechnologies.zshrs.ZshrsIcons.FILE">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- File > New > Zsh File (and right-click in Project view → New).
             `NewGroup` is the platform group ID for both the File menu
             and the Project-view popup New submenu, so this single
             registration surfaces in both. anchor="first" puts it
             near the top of the New menu so it's a one-key reach
             after typing N. -->
        <action
            id="zshrs.NewFile"
            class="com.menketechnologies.zshrs.actions.CreateZshrsFileAction"
            text="Zsh File"
            description="Create a new zsh / zshrs script"
            icon="com.menketechnologies.zshrs.ZshrsIcons.FILE">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
